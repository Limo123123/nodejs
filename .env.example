# MongoDB Zugangsdaten (Methode 1: User/Passwort separat)
#MONGO_USER=""
#MONGO_PASSWORD=""
# MONGO_URI wird dann im Code zusammengesetzt

# ODER MongoDB Zugangsdaten (Methode 2: Komplette URI)
# MONGO_URI=""
MONGO_URI=""

# Session Secret
SESSION_SECRET="" 

# Optional, aber gut für CORS und Session Cookie Sicherheit
NODE_ENV="production" 
# Deine Frontend URL (wichtig für CORS in Produktion)
FRONTEND_URL=""
GEMINI_API_KEY=
GROQ_API_KEY=

# E-Mail Provider Setup
SMTP_HOST="" # Dein Provider
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="" # Generell die E-Mail Addresse
SMTP_PASS="DeinSicheresPasswort123!" # Dein Email Passwort